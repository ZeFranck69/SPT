<svg
    class="tf-icon{{ class_name ? ' ' ~ class_name : '' }}"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
>
    {% if name == 'zap' %}
        <path d="M4 14a1 1 0 0 1-.78-1.63l9-11a.5.5 0 0 1 .87.45l-1.7 6.15A1 1 0 0 0 12.35 9H20a1 1 0 0 1 .78 1.63l-9 11a.5.5 0 0 1-.87-.45l1.7-6.15A1 1 0 0 0 11.65 14z"/>
    {% elseif name == 'smartphone' %}
        <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
        <path d="M12 18h.01"/>
    {% elseif name == 'users' %}
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
    {% elseif name == 'credit-card' %}
        <rect width="20" height="14" x="2" y="5" rx="2"/>
        <path d="M2 10h20"/>
    {% elseif name == 'circle-check' %}
        <circle cx="12" cy="12" r="10"/>
        <path d="m9 12 2 2 4-4"/>
    {% elseif name == 'phone' %}
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.33 1.84.56 2.8.69A2 2 0 0 1 22 16.92z"/>
    {% elseif name == 'wifi' %}
        <path d="M5 13a10 10 0 0 1 14 0M8.5 16.5a5 5 0 0 1 7 0M2 9.5a15 15 0 0 1 20 0M12 20h.01"/>
    {% elseif name == 'lock' %}
        <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
    {% elseif name == 'undo' %}
        <path d="m9 14-5-5 5-5"/>
        <path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5A5.5 5.5 0 0 1 14.5 20H11"/>
    {% elseif name == 'headphones' %}
        <path d="M4 14a8 8 0 0 1 16 0"/>
        <path d="M18 19c0 1.7-1.3 3-3 3h-1"/>
        <path d="M4 14v2a2 2 0 0 0 2 2h1v-6H6a2 2 0 0 0-2 2ZM20 14v2a2 2 0 0 1-2 2h-1v-6h1a2 2 0 0 1 2 2Z"/>
    {% elseif name == 'shopping-cart' %}
        <circle cx="8" cy="21" r="1"/>
        <circle cx="19" cy="21" r="1"/>
        <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h7.78a2 2 0 0 0 2-1.61L20.12 6H5.12"/>
    {% elseif name == 'user-round' %}
        <circle cx="12" cy="8" r="5"/>
        <path d="M20 21a8 8 0 0 0-16 0"/>
    {% elseif name == 'message-circle' %}
        <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/>
    {% elseif name == 'mail' %}
        <rect width="20" height="16" x="2" y="4" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
    {% elseif name == 'clock' %}
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
    {% elseif name == 'map-pin' %}
        <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/>
        <circle cx="12" cy="10" r="3"/>
    {% endif %}
</svg>
