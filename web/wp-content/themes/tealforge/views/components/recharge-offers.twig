<section id="{{ group.tone|e('html_attr') }}" class="tf-recharge-offers tf-recharge-offers--{{ group.tone|e('html_attr') }}" aria-labelledby="{{ group.tone|e('html_attr') }}-title">
    <div class="tf-recharge-offers__panel">
        <div class="tf-recharge-offers__intro">
            <span class="tf-recharge-offers__icon">
                {% include 'components/icon.twig' with { name: group.icon } only %}
            </span>
            <h2 id="{{ group.tone|e('html_attr') }}-title" class="tf-recharge-offers__title">{{ group.title|e }}</h2>
            {% if group.subtitle %}
                <p class="tf-recharge-offers__subtitle">{{ group.subtitle|e }}</p>
            {% endif %}
            {% if group.description %}
                <p class="tf-recharge-offers__description">{{ group.description|e }}</p>
            {% endif %}
            <span class="tf-recharge-offers__decoration" aria-hidden="true"></span>
        </div>
        <div class="tf-recharge-offers__cards">
            {% for product in group.products %}
                <article class="tf-recharge-offers__card">
                    {% if product.purchase_price != '' %}
                        <p class="tf-recharge-offers__price">
                            <span>{{ product.purchase_price|e }}</span>
                            <span class="tf-recharge-offers__currency">{{ section.currency_label|e }}</span>
                        </p>
                    {% endif %}
                    <h3 class="tf-recharge-offers__name">Recharge {{ product.family|upper|e }}</h3>
                    {% if product.bonus %}
                        <p class="tf-recharge-offers__bonus">
                            {% include 'components/icon.twig' with { name: group.bonus_icon } only %}
                            {{ product.bonus|e }}
                        </p>
                    {% endif %}
                    {% if group.delivery %}
                        <p class="tf-recharge-offers__delivery">{{ group.delivery|e }}</p>
                    {% endif %}
                    {% if product.voucher_managed and product.stock_label %}
                        <p class="tf-recharge-offers__stock">{{ product.stock_label|e }}</p>
                    {% endif %}
                    {% if product.can_quick_add %}
                        <form class="tf-recharge-offers__purchase" method="post" action="{{ function('esc_url', product.add_to_cart_action) }}">
                            <label class="tf-recharge-offers__quantity-label" for="recharge-quantity-{{ product.id|e('html_attr') }}">Quantité</label>
                            <div class="tf-recharge-offers__quantity" data-tf-quantity>
                                <button class="tf-recharge-offers__quantity-button" type="button" aria-label="Diminuer la quantité" data-tf-quantity-decrease>−</button>
                                <input class="tf-recharge-offers__quantity-input" id="recharge-quantity-{{ product.id|e('html_attr') }}" type="number" name="quantity" value="1" min="1" max="{{ product.max_quantity|e('html_attr') }}" step="1" inputmode="numeric">
                                <button class="tf-recharge-offers__quantity-button" type="button" aria-label="Augmenter la quantité" data-tf-quantity-increase>+</button>
                            </div>
                            <button class="tf-recharge-offers__button" type="submit" name="add-to-cart" value="{{ product.id|e('html_attr') }}" aria-label="Ajouter au panier la recharge {{ product.family|e('html_attr') }} de {{ product.purchase_price|e('html_attr') }} {{ section.currency_label|e('html_attr') }}">
                                Acheter
                                <svg class="tf-recharge-offers__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"/></svg>
                            </button>
                        </form>
                    {% else %}
                        <p class="tf-recharge-offers__unavailable">{{ product.unavailable_label|e }}</p>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    </div>
</section>
