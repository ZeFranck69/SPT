{% if menu and menu.items %}
    <nav class="{{ class_name }}"{% if mobile_panel %} data-tf-menu-panel{% endif %} aria-label="{{ aria_label ?: function('__', 'Navigation', 'tealforge') }}">
        <ul class="tf-menu__list">
            {% for item in menu.items %}
                <li class="tf-menu__item">
                    <a class="tf-menu__link" href="{{ function('esc_url', item.link) }}"{% if item.current and '#' not in item.link %} aria-current="page"{% endif %}>
                        {{ item.title }}
                    </a>
                </li>
            {% endfor %}
        </ul>
        {% if mobile_panel and account_url %}
            <div class="tf-menu__account">
                <a class="tf-menu__link" href="{{ function('esc_url', account_url) }}">{{ account_label|e }}</a>
            </div>
        {% endif %}
    </nav>
{% endif %}
