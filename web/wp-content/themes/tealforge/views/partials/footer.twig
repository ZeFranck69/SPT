<footer class="tf-site-footer">
    <div class="tf-site-footer__inner tf-container">
        <div class="tf-site-footer__brand">
            {% set footer_logo = spt_branding.footer_logo ?: spt_branding.header_logo %}
            <a class="tf-site-header__brand" href="{{ function('esc_url', site.url) }}">
                {% if footer_logo %}
                    <img
                        class="tf-site-footer__logo"
                        src="{{ function('esc_url', footer_logo.url) }}"
                        {% if footer_logo.srcset %}srcset="{{ function('esc_attr', footer_logo.srcset) }}" sizes="240px"{% endif %}
                        width="{{ footer_logo.width }}"
                        height="{{ footer_logo.height }}"
                        alt="{{ footer_logo.alt ?: site.name }}"
                    >
                {% else %}
                    <span class="tf-site-header__brand-mark">SPT</span>
                    <span class="tf-site-header__brand-copy">
                        <strong>{{ site.name }}</strong>
                        <small>Wallis &amp; Futuna</small>
                    </span>
                {% endif %}
            </a>
            <p>
                Service de recharges mobiles prépayées en ligne à Wallis et Futuna.
            </p>
        </div>

        {% include 'components/menu.twig' with {
            menu: menus.footer,
            class_name: 'tf-menu tf-menu--footer'
        } only %}

        <div class="tf-site-footer__meta">
            <p>&copy; {{ 'now'|date('Y') }} {{ site.name }}. Tous droits réservés.</p>
            <p>Paiement sécurisé</p>
        </div>
    </div>
</footer>
