<footer class="tf-site-footer">
    <div class="tf-site-footer__inner tf-container">
        <div class="tf-site-footer__main">
            <div class="tf-site-footer__brand">
                {% set footer_logo = spt_branding.footer_logo ?: spt_branding.header_logo %}
                <a class="tf-site-footer__brand-link{{ footer_logo ? ' tf-site-footer__brand-link--custom' : ' tf-site-footer__brand-link--fallback' }}" href="{{ function('esc_url', site.url) }}">
                    {% if footer_logo %}
                        <img
                            class="tf-site-footer__logo"
                            src="{{ function('esc_url', footer_logo.url) }}"
                            {% if footer_logo.srcset %}srcset="{{ function('esc_attr', footer_logo.srcset) }}" sizes="240px"{% endif %}
                            width="{{ footer_logo.width }}"
                            height="{{ footer_logo.height }}"
                            alt="{{ footer_logo.alt ?: site.name }}"
                        >
                    {% else %}
                        <img
                            class="tf-site-footer__logo"
                            src="{{ function('get_theme_file_uri', 'assets/images/rtm-logo.png') }}"
                            width="367"
                            height="112"
                            alt="Recharge Ton Manuia"
                        >
                    {% endif %}
                </a>
                <p>Service de recharges mobiles prépayées en ligne à Wallis et Futuna.</p>

                <div class="tf-site-footer__network">
                    {% if spt_branding.network_logo %}
                        <img
                            class="tf-site-footer__network-logo"
                            src="{{ function('esc_url', spt_branding.network_logo.url) }}"
                            width="{{ spt_branding.network_logo.width }}"
                            height="{{ spt_branding.network_logo.height }}"
                            alt="{{ spt_branding.network_logo.alt ?: 'Manuia' }}"
                            loading="lazy"
                        >
                    {% else %}
                        <img
                            class="tf-site-footer__network-logo"
                            src="{{ function('get_theme_file_uri', 'assets/images/manuia-logo.jpg') }}"
                            width="600"
                            height="240"
                            alt="Manuia, le réseau mobile de Wallis et Futuna"
                            loading="lazy"
                        >
                    {% endif %}
                </div>
                <small>Recharges du réseau mobile Manuia</small>
            </div>

            <div class="tf-site-footer__column">
                <h2 class="tf-site-footer__title">Recharges</h2>
                {% include 'components/menu.twig' with {
                    menu: menus.footer_recharges,
                    class_name: 'tf-menu tf-menu--footer',
                    aria_label: 'Recharges'
                } only %}
            </div>

            <div class="tf-site-footer__column">
                <h2 class="tf-site-footer__title">Aide</h2>
                {% include 'components/menu.twig' with {
                    menu: menus.footer_help ?: menus.footer,
                    class_name: 'tf-menu tf-menu--footer',
                    aria_label: 'Aide et informations légales'
                } only %}
            </div>

            <div class="tf-site-footer__column tf-site-footer__contact">
                <h2 class="tf-site-footer__title">Contact</h2>
                {% if spt_contact.email %}
                    <a href="mailto:{{ function('esc_attr', spt_contact.email) }}">{{ spt_contact.email }}</a>
                {% endif %}
                {% if spt_contact.address %}
                    <p>{{ function('nl2br', function('esc_html', spt_contact.address))|raw }}</p>
                {% endif %}
                {% if spt_contact.hours %}
                    <p class="tf-site-footer__hours">{{ function('nl2br', function('esc_html', spt_contact.hours))|raw }}</p>
                {% endif %}
            </div>
        </div>

        <div class="tf-site-footer__meta">
            <div class="tf-site-footer__legal">
                <div class="tf-site-footer__copyright">
                    {% if spt_footer.copyright %}
                        {{ function('wp_kses_post', spt_footer.copyright)|raw }}
                    {% else %}
                        &copy; {{ 'now'|date('Y') }} {{ site.name }}. Tous droits réservés.
                    {% endif %}
                </div>
                {% if spt_footer.created_by %}
                    <div class="tf-site-footer__created-by">
                        {{ function('wp_kses_post', spt_footer.created_by)|raw }}
                    </div>
                {% endif %}
            </div>
            <p class="tf-site-footer__payment">
                {% include 'components/icon.twig' with { name: 'lock' } only %}
                <span>Paiement sécurisé par carte bancaire</span>
            </p>
        </div>
    </div>
</footer>
