<header class="tf-site-header">
    <div class="tf-site-header__inner tf-container">
        <a class="tf-site-header__brand" href="{{ function('esc_url', site.url) }}">
            {% if spt_branding.header_logo %}
                <img
                    class="tf-site-header__logo"
                    src="{{ function('esc_url', spt_branding.header_logo.url) }}"
                    {% if spt_branding.header_logo.srcset %}srcset="{{ function('esc_attr', spt_branding.header_logo.srcset) }}" sizes="220px"{% endif %}
                    width="{{ spt_branding.header_logo.width }}"
                    height="{{ spt_branding.header_logo.height }}"
                    alt="{{ spt_branding.header_logo.alt ?: site.name }}"
                >
                {% if spt_branding.header_logo_text %}
                    <span class="tf-site-header__logo-text">{{ spt_branding.header_logo_text }}</span>
                {% endif %}
            {% else %}
                <span>Recharge Ton Manuia</span>
            {% endif %}
        </a>

        {% include 'components/menu.twig' with {
            menu: menus.primary,
            class_name: 'tf-menu tf-menu--primary',
            mobile_panel: true,
            aria_label: 'Navigation principale'
        } only %}

        <div class="tf-site-header__controls">
            <div class="tf-site-header__actions">
                <a
                    class="tf-site-header__action tf-site-header__action--account{{ spt_account.is_logged_in ? ' tf-site-header__action--authenticated' : '' }}"
                    href="{{ function('esc_url', spt_links.account) }}"
                    aria-label="{{ spt_account.header_label }}"
                    title="{{ spt_account.header_label }}"
                >
                    {% include 'components/icon.twig' with { name: 'user-round' } only %}
                    <span class="tf-site-header__action-label">{{ spt_account.header_label }}</span>
                </a>

                <a
                    class="tf-site-header__action tf-site-header__action--cart"
                    href="{{ function('esc_url', spt_links.cart) }}"
                    aria-label="Panier"
                    title="Panier"
                >
                    {% include 'components/icon.twig' with { name: 'shopping-cart' } only %}
                    <span class="tf-site-header__action-label">Panier</span>
                    {{ function('tealforge_render_header_cart_count')|raw }}
                </a>
            </div>

            <div class="tf-site-header__partner" aria-label="Réseau mobile Manuia">
                {% if spt_branding.network_logo %}
                    <img
                        src="{{ function('esc_url', spt_branding.network_logo.url) }}"
                        width="{{ spt_branding.network_logo.width }}"
                        height="{{ spt_branding.network_logo.height }}"
                        alt="{{ spt_branding.network_logo.alt ?: 'Manuia' }}"
                    >
                {% else %}
                    <span>Manuia</span>
                {% endif %}
            </div>

            <button
                class="tf-site-header__toggle"
                type="button"
                aria-label="{{ function('__', 'Ouvrir le menu', 'tealforge') }}"
                aria-expanded="false"
                data-tf-menu-toggle
                data-tf-menu-open-label="{{ function('__', 'Ouvrir le menu', 'tealforge') }}"
                data-tf-menu-close-label="{{ function('__', 'Fermer le menu', 'tealforge') }}"
            >
                <span class="tf-site-header__toggle-lines" aria-hidden="true"></span>
            </button>
        </div>
    </div>
</header>
<button
    class="tf-site-menu-backdrop"
    type="button"
    aria-label="{{ function('__', 'Fermer le menu', 'tealforge') }}"
    data-tf-menu-close
></button>
