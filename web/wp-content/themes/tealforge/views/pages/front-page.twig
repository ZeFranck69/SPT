{% extends 'layouts/base.twig' %}

{% block content %}
    {% if woocommerce_notices %}
        <div class="tf-home-notices" aria-live="polite">
            {{ woocommerce_notices|raw }}
        </div>
    {% endif %}

    {% for section in sections %}
        {% include ['sections/' ~ section.acf_fc_layout ~ '.twig', 'sections/unknown.twig'] with {
            section: section
        } only %}
    {% endfor %}
{% endblock %}
