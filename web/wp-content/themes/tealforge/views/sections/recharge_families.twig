<section class="tf-recharge-families" aria-label="Familles de recharge">
    <div class="tf-recharge-families__inner">
        {% for family in section.families %}
            <article
                class="tf-recharge-family tf-recharge-family--{{ family.tone }}"
                data-tf-reveal
                data-tf-reveal-delay="{{ loop.index0 % 2 }}"
            >
                <p class="tf-recharge-family__eyebrow">{{ family.eyebrow }}</p>
                <h2 class="tf-recharge-family__title">{{ family.title }}</h2>
                <p class="tf-recharge-family__text">{{ family.text }}</p>
            </article>
        {% endfor %}
    </div>
</section>
