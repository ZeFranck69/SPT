<section id="fonctionnement" class="tf-recharge-steps" aria-labelledby="recharge-steps-title">
    <div class="tf-recharge-steps__inner">
        <div class="tf-recharge-steps__intro" data-tf-reveal>
            <h2 id="recharge-steps-title" class="tf-recharge-steps__title">{{ section.title|e }}</h2>
            {% if section.lead %}<p class="tf-recharge-steps__lead">{{ section.lead|e }}</p>{% endif %}
        </div>

        {% if section.steps %}
            <ol class="tf-recharge-steps__list">
                {% for step in section.steps %}
                    <li
                        class="tf-recharge-step tf-recharge-step--{{ step.tone|e('html_attr') }}"
                        data-tf-reveal
                        data-tf-reveal-delay="{{ loop.index0 % 4 }}"
                    >
                        <span class="tf-recharge-step__decoration" aria-hidden="true"></span>
                        <div class="tf-recharge-step__header">
                            <span class="tf-recharge-step__number">{{ step.number|e }}</span>
                            <span class="tf-recharge-step__icon-wrap" aria-hidden="true">
                                {% include 'components/icon.twig' with { name: step.icon, class_name: 'tf-recharge-step__icon' } only %}
                            </span>
                        </div>
                        <div class="tf-recharge-step__content">
                            <h3 class="tf-recharge-step__title">{{ step.title|e }}</h3>
                            <p class="tf-recharge-step__text">{{ step.text|e }}</p>
                        </div>
                    </li>
                {% endfor %}
            </ol>
            <div class="tf-recharge-steps__frieze" aria-hidden="true"></div>
        {% endif %}
    </div>
</section>
