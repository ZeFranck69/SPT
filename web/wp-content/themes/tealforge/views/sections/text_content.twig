{% if section.title or section.content %}
{% set heading_tag = section.heading_level == 1 ? 'h1' : 'h2' %}
<section class="tf-text-content"{% if section.title %} aria-labelledby="text-content-title-{{ section_index|default(1)|e('html_attr') }}"{% endif %}>
    <div class="tf-text-content__inner">
        {% if section.title %}
            <{{ heading_tag }} id="text-content-title-{{ section_index|default(1)|e('html_attr') }}" class="tf-text-content__title" data-tf-reveal>
                {{ section.title|e }}
            </{{ heading_tag }}>
        {% endif %}

        {% if section.content %}
            <div class="tf-text-content__body tf-wysiwyg" data-tf-reveal data-tf-reveal-delay="1">
                {{ function('wp_kses_post', section.content)|raw }}
            </div>
        {% endif %}
    </div>
</section>
{% endif %}
