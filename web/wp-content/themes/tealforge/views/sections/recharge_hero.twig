<section class="tf-recharge-hero" aria-labelledby="recharge-hero-title">
    {% if section.hero_image %}
        <figure class="tf-recharge-hero__visual">
            {% if section.hero_image_html %}
                {{ section.hero_image_html|raw }}
            {% else %}
                <img
                    class="tf-recharge-hero__image"
                    src="{{ function('esc_url', section.hero_image) }}"
                    alt=""
                    width="900"
                    height="700"
                    fetchpriority="high"
                    loading="eager"
                    decoding="async"
                >
            {% endif %}
        </figure>
    {% endif %}
    <div class="tf-recharge-hero__inner">
        <div class="tf-recharge-hero__content">
            <h1 id="recharge-hero-title" class="tf-recharge-hero__title">{{ section.title|e }}</h1>

            {% if section.text %}
                <p class="tf-recharge-hero__text">{{ section.hero_text_html|raw }}</p>
            {% endif %}

            {% if section.benefits %}
                <ul class="tf-recharge-hero__benefits">
                    {% for benefit in section.benefits %}
                        <li class="tf-recharge-hero__benefit">
                            <span class="tf-recharge-hero__benefit-icon">
                                {% include 'components/icon.twig' with { name: benefit.icon } only %}
                            </span>
                            {{ benefit.label|e }}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            {% if (section.primary_label and section.primary_url) or (section.secondary_label and section.secondary_url) %}
                <div class="tf-recharge-hero__actions">
                    {% if section.primary_label and section.primary_url %}
                        <a class="tf-recharge-hero__button" href="{{ function('esc_url', section.primary_url) }}">{{ section.primary_label|e }}</a>
                    {% endif %}
                    {% if section.secondary_label and section.secondary_url %}
                        <a class="tf-recharge-hero__button tf-recharge-hero__button--secondary" href="{{ function('esc_url', section.secondary_url) }}">{{ section.secondary_label|e }}</a>
                    {% endif %}
                </div>
            {% endif %}

            {% if section.note %}
                <p class="tf-recharge-hero__note">{{ section.note|e }}</p>
            {% endif %}
        </div>
    </div>
</section>
